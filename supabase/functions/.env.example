# Edge Function secrets. In production set these in:
#   Supabase Dashboard → Edge Functions → Secrets
# For local `supabase functions serve`, copy to supabase/functions/.env (gitignored).
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase — do not set them.

# Cloudflare R2 (Cloudflare Dashboard → R2 → Manage API tokens → "Object Read & Write", scoped to the bucket)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=savestate-backups
