# Copy to web/.env.local for local development.
# Both values are public (they end up in the browser bundle). Row Level Security protects the data.
# Get them from Supabase → Project Settings → API (use the "publishable" key).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
